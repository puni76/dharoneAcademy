@model DailyTask
@{
    ViewData["Title"] = "Delete Daily Task";
}

<div class="form-panel">
    <h2>Delete this task?</h2>
    <p>@Model.TaskTitle — @Model.TaskDate.ToString("dd MMM yyyy") (@Model.StudentProfile?.User?.FullName)</p>
    <form asp-action="Delete" method="post" class="actions">
        <input type="hidden" asp-for="Id" />
        <button class="btn-danger" type="submit">Delete</button>
        <a class="btn-ghost" asp-action="Index">Cancel</a>
    </form>
</div>
