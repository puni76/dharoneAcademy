@{
    ViewData["Title"] = "Curriculum";
}

<section class="page-hero" style="--page-bg:url('@Url.Content("~/images/coding.jpg")')">
    <div class="container">
        <p class="eyebrow">Curriculum</p>
        <h1>Industry-aligned full-stack path</h1>
        <p>Front-end, .NET back-end, SQL, and live corporate-style projects.</p>
    </div>
</section>

<section class="section">
    <div class="container curriculum">
        <article>
            <span>01</span>
            <h3>Front-End Foundations</h3>
            <p>HTML5, CSS3, JavaScript and React JS for responsive product interfaces.</p>
        </article>
        <article>
            <span>02</span>
            <h3>ASP.NET Core MVC</h3>
            <p>Controllers, views, auth, validation, and production patterns with .NET 8.</p>
        </article>
        <article>
            <span>03</span>
            <h3>SQL Server</h3>
            <p>Schema design, relationships, CRUD systems, and real reporting queries.</p>
        </article>
        <article>
            <span>04</span>
            <h3>Live Capstone</h3>
            <p>Build and ship corporate-level applications with mentor code reviews.</p>
        </article>
    </div>
</section>
