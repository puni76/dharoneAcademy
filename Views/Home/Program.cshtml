@{
    ViewData["Title"] = "Internship Program";
}

<section class="page-hero" style="--page-bg:url('@Url.Content("~/images/career.jpg")')">
    <div class="container">
        <p class="eyebrow">Program</p>
        <h1>3-Month Internship &amp; Training</h1>
        <p>For BCA | MCA | BE | Diploma students — structured for evening learners.</p>
    </div>
</section>

<section class="section">
    <div class="container info-grid">
        <article>
            <h3>Duration</h3>
            <p>3 Months of guided learning and live projects.</p>
        </article>
        <article>
            <h3>Investment</h3>
            <p>₹30,000 inclusive of mentoring and project support.</p>
        </article>
        <article>
            <h3>Timing</h3>
            <p>Daily sessions from 6:00 PM — perfect for students.</p>
        </article>
        <article>
            <h3>Certificate</h3>
            <p>Official Internship Certificate through Dharone Technologies Pvt Ltd.</p>
        </article>
    </div>
</section>

<section class="section tint">
    <div class="container split">
        <div class="split-visual">
            <img src="~/images/flyer.png" alt="Dharone Academy program flyer" />
        </div>
        <div class="split-copy">
            <p class="eyebrow gold">Outcomes</p>
            <h2>Daily tasks &amp; updates keep progress visible.</h2>
            <p>Track attendance, topics, mentor feedback and project status inside your student portal — just like industry standup culture.</p>
            <a class="btn-navy" asp-controller="Account" asp-action="Register">Create student account</a>
        </div>
    </div>
</section>
